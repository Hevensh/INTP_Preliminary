\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Learned parameters from the best dual-\textsc  {Look}{} model (\ensuremath  {\mathcal  {G}_{6,3}} + PE + Image \textsc  {Look}{} + G3 Feature \textsc  {Look}{}). Left: per-layer, per-head RMS magnitude for Image and Feature \textsc  {Look}{}, shown with separate color scales. Right: the three layer--head fields with the largest angular contrast from each branch, measured after removing the mean of every radial ring. Each signed $4\times 12$ map is shown separately rather than mixing heads as RGB. G3 reuses one pose probe for each consecutive three-layer group, while every active layer retains its own output field. Nonuniform fields are an implementation-level observation, not a causal interpretability claim.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:look-fields}{{5}{9}{Learned parameters from the best dual-\look {} model (\geom {6}{3} + PE + Image \look {} + G3 Feature \look {}). Left: per-layer, per-head RMS magnitude for Image and Feature \look {}, shown with separate color scales. Right: the three layer--head fields with the largest angular contrast from each branch, measured after removing the mean of every radial ring. Each signed $4\times 12$ map is shown separately rather than mixing heads as RGB. G3 reuses one pose probe for each consecutive three-layer group, while every active layer retains its own output field. Nonuniform fields are an implementation-level observation, not a causal interpretability claim}{figure.caption.10}{}}
